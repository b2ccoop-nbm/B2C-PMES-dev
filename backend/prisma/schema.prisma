generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  /** Pooled/serverless URL in production (e.g. Neon pooler). */
  url       = env("DATABASE_URL")
  /** Direct (non-pooler) URL for migrations — required by Prisma when set; use same as `DATABASE_URL` for local Postgres. */
  directUrl = env("DIRECT_URL")
}

/** Back-office staff: one bootstrap superuser (CLI), additional admins created only by superuser. */
model StaffUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         StaffRole
  createdAt    DateTime  @default(now())
  createdById  String?
  createdBy    StaffUser?  @relation("StaffCreatedBy", fields: [createdById], references: [id])
  createdStaff StaffUser[] @relation("StaffCreatedBy")
  boardVotes   BoardApprovalVote[]
  confirmedMembershipPayments MembershipApplication[] @relation("MembershipPaymentConfirmedBy")
}

enum StaffRole {
  SUPERUSER
  ADMIN
  /** Confirms share capital + membership fee receipt */
  TREASURER
  /** Director vote toward majority approval */
  BOARD_DIRECTOR
  /** Issues Board Resolution number and final board approval gate */
  SECRETARY
  CHAIRMAN
  VICE_CHAIRMAN
  GENERAL_MANAGER
}

model Participant {
  id            String    @id @default(uuid())
  /** Firebase Authentication uid — set on first sync after sign-up */
  firebaseUid   String?   @unique
  fullName      String
  email         String    @unique
  phone         String
  dob           String
  gender        String
  createdAt     DateTime  @default(now())
  /** Set when treasury confirms share capital + membership fees received */
  initialFeesPaidAt   DateTime?
  /** When at least 3 of 5 BOD votes to approve (see BoardApprovalVote). */
  bodMajorityReachedAt DateTime?
  /** Secretary-issued resolution id, e.g. APR-2026-001 (unique when set). */
  boardResolutionNo   String?   @unique
  /** Set when Secretary confirms BOD process and member may complete full profile */
  boardApprovedAt     DateTime?
  /** Member finished post-approval full profile + optional sheet upload */
  fullProfileCompletedAt DateTime?
  /** Extra structured fields after board approval (JSON for flexibility) */
  fullProfileJson     String?   @db.Text
  /** Full membership form object (same shape as client `profileJson`) for reporting and admin detail */
  memberProfileSnapshot Json?
  /** Denormalized from full profile for search/list (present address formatted) */
  mailingAddress      String?   @db.Text
  civilStatus           String?
  /** Normalized digits (typically 9). Unique when set; blanks are stored as NULL. */
  tinNo                 String?   @unique
  /** B2C public login ID (`B2C-II-YY-XXXX`). Unique when set. */
  memberIdNo            String?   @unique
  /** Set when an online application is submitted without TIN; cleared when TIN is saved. */
  tinMissingFlaggedAt   DateTime?
  /** "online_form" | "self_signup" | "legacy_import" */
  registrationSource    String?
  /**
   * Optional member-chosen handle (lowercase). Unique when set; authenticated changes via PATCH /pmes/member/callsign.
   * Alternate public label when set; otherwise see lastNameKey + lastNameSeq (e.g. cruz-2).
   */
  callsign              String?   @unique
  /** Normalized slug from legal last name for default alternate id (e.g. delacruz). */
  lastNameKey           String?
  /** Sequence within lastNameKey for default alternate (brothers share surname → cruz-1, cruz-2). */
  lastNameSeq           Int?
  /** Preloaded roster row (admin import): member reclaims Firebase account + completes digital profile */
  legacyPioneerImport   Boolean   @default(false)
  /**
   * Optimistic concurrency for the membership profile form. Incremented on profile-visible writes (callsign,
   * login-email merge, superuser member ID patch, successful full-profile submit). Not bumped when assigning a
   * provisional public ID during lifecycle loads (`ensureMemberPublicId`), so members are not forced to refresh
   * just because the server filled `memberIdNo`.
   */
  memberProfileConcurrencyStamp Int @default(0)
  /** Full legacy sheet row (B2C registry columns + extras) for audit and reclaim support */
  registryImportSnapshot Json?
  /** Member who referred this account (PIONEER-xxxxxxxx link); set once at first Firebase sync when valid. */
  referredByParticipantId String?
  referredBy                Participant?  @relation("ReferralAttribution", fields: [referredByParticipantId], references: [id], onDelete: SetNull)
  referralReferees          Participant[] @relation("ReferralAttribution")
  /** Set when this member completes full membership (referrer earns Pioneer Points once). */
  referralJoinCreditedAt    DateTime?
  boardApprovalVotes        BoardApprovalVote[]
  pmesRecords   PmesRecord[]
  loiSubmission LoiSubmission?
  storeOrders   StoreOrder[]
  membershipApplication MembershipApplication?

  @@index([referredByParticipantId])
}

enum MembershipApplicationStatus {
  DRAFT
  SUBMITTED
  PAYMENT_CONFIRMED
  BOD_APPROVED
  APPROVED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum PaymentMode {
  CASH
  GCASH
}

/** Public online membership registration (FEAT-004). Drafts expire after 60 days. */
model MembershipApplication {
  id                      String                       @id @default(uuid())
  status                  MembershipApplicationStatus  @default(DRAFT)
  resumeTokenHash         String                       @unique
  resumeTokenExpiresAt    DateTime?
  pendingResumeTokenHash  String?                      @unique
  pendingResumeTokenExpiresAt DateTime?
  participantId           String?                      @unique
  participant             Participant?                 @relation(fields: [participantId], references: [id], onDelete: SetNull)
  fullName                String?
  firstName               String?
  middleName              String?
  lastName                String?
  dob                     DateTime?                    @db.Date
  gender                  String?
  email                   String
  mobile                  String?
  tinNo                   String?
  residentialAddress      Json?
  referredByParticipantId String?
  shareCapitalAmount      Decimal                      @default(1000) @db.Decimal(14, 2)
  shareCapitalPaid        Boolean                      @default(false)
  membershipFeeAmount     Decimal                      @default(500) @db.Decimal(14, 2)
  membershipFeePaid       Boolean                      @default(false)
  paymentMode             PaymentMode?
  gcashRefNo              String?
  gcashScreenshotKey      String?
  paymentDeclaredAt       DateTime?
  treasurerNotifiedAt     DateTime?
  dpaConsentAt            DateTime?
  dpaConsentVersion       String?
  consentIp               String?
  userAgent               String?
  possibleDuplicateOfId   String?
  submittedAt             DateTime?
  paymentConfirmedAt      DateTime?
  paymentConfirmedById    String?
  paymentConfirmedBy      StaffUser?                   @relation("MembershipPaymentConfirmedBy", fields: [paymentConfirmedById], references: [id], onDelete: SetNull)
  receiptNo               String?
  rejectedAt              DateTime?
  rejectionReason         String?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt

  @@index([status])
  @@index([email])
  @@index([mobile])
  @@index([tinNo])
}

/** Sliding-window counters for public membership endpoints (per IP / email). */
model MembershipRateLimit {
  id          String   @id @default(uuid())
  bucketKey   String
  windowStart DateTime
  count       Int      @default(0)

  @@unique([bucketKey, windowStart])
  @@index([bucketKey])
}

/** Member / webhook store checkout — posts to accounting via `externalId` (idempotent). */
model StoreOrder {
  id                  String           @id @default(uuid())
  /** Idempotency key sent to accounting, e.g. order:<uuid> */
  externalId          String           @unique
  participantId       String?
  participant         Participant?     @relation(fields: [participantId], references: [id], onDelete: SetNull)
  vendorCode          String
  grossAmount         Decimal          @db.Decimal(14, 2)
  salesAmount         Decimal          @db.Decimal(14, 2)
  vendorPayableAmount Decimal          @db.Decimal(14, 2)
  currency            String           @default("PHP")
  status              StoreOrderStatus @default(POSTED)
  lineItems           Json
  memo                String?
  metadata            Json?
  createdAt           DateTime         @default(now())

  @@index([participantId])
  @@index([vendorCode])
}

enum StoreOrderStatus {
  POSTED
  FAILED
}

/** One vote per director per membership application (approve / not). */
model BoardApprovalVote {
  id            String   @id @default(uuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  staffUserId   String
  staffUser     StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  approve       Boolean
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([participantId, staffUserId])
  @@index([participantId])
}

/** Serial for Board Resolution numbers: MMM-YYYY-NNN (NNN per month-year). */
model BoardResolutionCounter {
  year    Int
  month   Int
  lastSeq Int @default(0)

  @@id([year, month])
}

/** Atomic per-surname sequence for default alternate ids (lastname-1, lastname-2, …). */
model LastNameCounter {
  lastNameKey String @id
  nextSeq     Int    @default(0)
}

model PmesRecord {
  id            String      @id @default(uuid())
  score         Int
  passed        Boolean
  timestamp     DateTime    @default(now())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id])
}

model LoiSubmission {
  id             String      @id @default(uuid())
  address        String
  occupation     String
  employer       String
  initialCapital Float
  submittedAt    DateTime    @default(now())
  participantId  String      @unique
  participant    Participant @relation(fields: [participantId], references: [id])
}
