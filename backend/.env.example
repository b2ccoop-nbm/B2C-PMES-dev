NODE_ENV=development

# --- Local dev (Docker Postgres) — copy to .env and use for day-to-day coding; does not touch Neon. ---
# Start DB:  cd backend && npm run db:up
# Schema:    npx prisma migrate deploy   (or prisma migrate dev when you add migrations)
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/b2ccoop_webapp
# For local Postgres, same connection string as DATABASE_URL (not pooled).
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/b2ccoop_webapp

# --- Production (Neon) — set only on the host / CI, never in your laptop .env for normal dev. ---
# Template: backend/.env.production.example   Checklist: docs/deploy-neon.md
PORT=3000

# Staff JWT (superuser + admins) — min 32 chars.
ADMIN_JWT_SECRET=change-me-to-a-secret-at-least-32-chars-long

# Optional: require X-Member-Sync-Secret on POST /auth/sync-member (Firebase → Postgres bridge). Use a long random string in production.
# Browsers use Authorization: Bearer <Firebase ID token> instead — set the three vars below (Firebase Console → Project settings → Service accounts).
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# MEMBER_SYNC_SECRET=
# Bootstrap: after migrate, run once:
#   cd backend && npm run create-superuser -- you@example.com 'YourSecurePassword'
# Only one superuser is allowed; further staff are ADMIN accounts created by the superuser (API + UI).

# AI TTS: noop | gemini | openai | grok (xAI). Keys only for the active provider.
AI_PROVIDER=noop
GEMINI_API_KEY=
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Landing Ka-uban chat (text, marketing page): noop | gemini. Uses GEMINI_API_KEY when gemini.
LANDING_CHAT_PROVIDER=noop
# GEMINI_CHAT_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
# OPENAI_TTS_MODEL=tts-1

# Grok / xAI TTS (https://api.x.ai/v1/tts)
XAI_API_KEY=

# B2CCoop Accounting (separate repo) — posts journal when Treasurer confirms initial fees
# B2CCoop Accounting (local dev — must match accounting backend INTEGRATION_SERVICE_SECRET)
ACCOUNTING_API_URL=http://localhost:3010
ACCOUNTING_INTEGRATION_SECRET=b2ccoop-accounting-integration-secret-2026-muex
INITIAL_MEMBERSHIP_FEE_AMOUNT=1500
# INITIAL_MEMBERSHIP_FEE_AMOUNT=1500

# External store checkout webhook (Versa / third-party) → POST /integrations/store/checkout
# STORE_CHECKOUT_WEBHOOK_SECRET=change-me-store-webhook-secret

# B2C-Store member resolve — must match WEBAPP_INTEGRATION_SECRET in B2C-Store apps/api/.dev.vars
# STORE_INTEGRATION_SECRET=b2ccoop-store-webapp-integration-secret-2026

# FEAT-004 online membership — keep Gmail sending OFF until b2ccoop@gmail.com OAuth is granted.
# GMAIL_SENDING_ENABLED=false
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REFRESH_TOKEN=
# GMAIL_FROM=b2ccoop@gmail.com
# TURNSTILE_SECRET_KEY=
# MEMBERSHIP_CRON_SECRET=
# DPA_CONSENT_VERSION=2026-10-21
# PUBLIC_APP_URL=http://localhost:5173
