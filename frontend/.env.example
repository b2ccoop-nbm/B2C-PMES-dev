VITE_APP_ID=b2ccoop-webapp
# Enable Email/Password in Firebase Console → Authentication → Sign-in method (member accounts + PMES resume).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Nest API base (TTS, member sync to Postgres, etc.). No Gemini key in the browser.
# Member sync uses Firebase ID tokens; backend must have Firebase Admin service account vars to verify tokens in production.
VITE_API_BASE_URL=http://localhost:3000

# B2CCoop Accounting UI (separate repo) — staff "Treasury / Accounting" on home + admin
# Production: https://finance.b2ccoop.com (see .env.production)
VITE_ACCOUNTING_APP_URL=http://localhost:5174

# B2CCoop Store (separate repo) — member portal opens external marketplace
# Production: https://store.b2ccoop.com (see .env.production)
# VITE_COOP_STORE_URL=http://localhost:5175

# FEAT-004 public membership form (optional Turnstile site key)
# VITE_TURNSTILE_SITE_KEY=
